# E.M.I.T. Backend Configuration Example
HOST=127.0.0.1
PORT=8000

# MongoDB Connection String (Supports local or MongoDB Atlas URIs)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=emit

# Test Database Connection (Optional, used during pytest execution)
MONGODB_TEST_URI=mongodb://localhost:27017
MONGODB_TEST_DATABASE=emit_test

# CORS Allowed Origins (Comma-separated list)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
